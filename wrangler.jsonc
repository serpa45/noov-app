{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noov-app",
  "account_id": "88c3de75d07ceeb5bffad0346b0d232d",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/media/*"
    ]
  },
  "vars": {
    "SUPABASE_URL": "https://mwnjoglolbyeyrmkqqqc.supabase.co",
    "R2_MEDIA_ENABLED": "false"
  },
  "secrets": {
    "required": [
      "SUPABASE_SERVICE_ROLE_KEY"
    ]
  },
  "env": {
    "r2": {
      "name": "noov-app-r2-preview",
      "assets": {
        "directory": "./.wrangler/r2-preview-dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api",
          "/api/*",
          "/media/*"
        ]
      },
      "vars": {
        "SUPABASE_URL": "https://mwnjoglolbyeyrmkqqqc.supabase.co",
        "R2_MEDIA_ENABLED": "true"
      },
      "secrets": {
        "required": [
          "SUPABASE_SERVICE_ROLE_KEY",
          "SUPABASE_PUBLISHABLE_KEY"
        ]
      },
      "r2_buckets": [
        {
          "binding": "R2_IMAGES",
          "bucket_name": "noov-images"
        }
      ],
      "routes": []
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "routes": [
    {
      "pattern": "noov.app.br",
      "custom_domain": true
    },
    {
      "pattern": "www.noov.app.br",
      "custom_domain": true
    }
  ]
}
